\newcommand{\brushrule}{%
  \begin{tikzpicture}[x=\textwidth,y=1pt]
    \path[fill=cvbrush]
      (0,0.2) -- (.04,.9) -- (.12,2.0) -- (.25,1.3) --
      (.40,2.3) -- (.57,1.5) -- (.74,2.1) -- (.91,1.7) --
      (1,.7) -- (.96,-.15) -- (.78,-.55) -- (.58,-.2) --
      (.37,-.7) -- (.17,-.15) -- (.05,-.45) -- cycle;
  \end{tikzpicture}\par
}

\newcommand{\cvsection}[1]{%
  \vspace{2.4ex}%
  {\fontsize{14}{15.5}\selectfont\bfseries\color{cvblue}\MakeUppercase{#1}}\par\nobreak
  \vspace{-0.1ex}\brushrule\vspace{1.2ex}%
}

% Ragged right: without hyphenation, justified bullets open wide word gaps.
% Spaces may shrink but never stretch, and extra lines are expensive, so
% bullets keep the density of justified text.
\newcommand{\cvragged}{%
  \raggedright
  \spaceskip=\fontdimen2\font plus 0pt minus \fontdimen4\font
  \xspaceskip=\spaceskip
  \linepenalty=1000\relax}
\newenvironment{cvpoints}{%
  \begin{itemize}[leftmargin=1.05em,labelsep=.45em,itemsep=3.2pt,topsep=2.8pt,
    partopsep=0pt,parsep=0pt,before=\cvragged,label={\color{cvtext}\raisebox{.15ex}{\scriptsize--}}]%
}{\end{itemize}}

