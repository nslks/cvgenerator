\#{ ---------- Berufserfahrung ---------- }
%% if cv.experience
\section*{Berufserfahrung}
%% for exp in cv.experience
\entryhead{\VAR{ exp.role | tex }}{\VAR{ exp.company | tex }}{\VAR{ exp.start | ym } -- \VAR{ exp.end | ym if exp.end else 'heute' }}{\VAR{ exp.location | tex if exp.location else '' }}
%% for phase in exp.phases
\textbf{\VAR{ phase.start.year }--\VAR{ phase.end.year if phase.end else 'heute' } · \VAR{ phase.title | tex }}\par
%% if phase.company
\textit{\VAR{ phase.company | tex }}\par
%% endif
%% if phase.achievements
\begin{points}
%% for a in phase.achievements
  \item \VAR{ a.title | tex }\BLOCK{ if a.impact } --- \textit{\VAR{ a.impact | tex }}\BLOCK{ endif }
%% endfor
\end{points}
%% endif
%% if phase.tech
{\small\textit{Tech:} \VAR{ phase.tech | map('tex') | join(', ') }}\par
%% endif
\vspace{0.18em}
