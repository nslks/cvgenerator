%% if exp.achievements
\begin{points}
%% for a in exp.achievements
  \item \VAR{ a.title | tex }\BLOCK{ if a.impact } --- \textit{\VAR{ a.impact | tex }}\BLOCK{ endif }
%% endfor
\end{points}
%% endif
%% if exp.tech
{\small\textit{Tech:} \VAR{ exp.tech | map('tex') | join(', ') }}\par
%% endif
\vspace{0.28em}
%% endfor
%% endif

\#{ ---------- Projekte ---------- }
%% if cv.projects
\section*{Projekte}
%% for p in cv.projects
\textbf{\VAR{ p.name | tex }}\BLOCK{ if p.url } {\small(\href{\VAR{ p.url }}{\VAR{ p.url.host | tex }})}\BLOCK{ endif }\BLOCK{ if p.tagline } --- \textit{\VAR{ p.tagline | tex }}\BLOCK{ endif }\par
%% if p.achievements
\begin{points}
%% for a in p.achievements
  \item \VAR{ a.title | tex }\BLOCK{ if a.impact } --- \textit{\VAR{ a.impact | tex }}\BLOCK{ endif }
